@PF3311.TeleRehab.Api_HostAddress = http://localhost:5150

POST {{PF3311.TeleRehab.Api_HostAddress}}/api/patients
Content-Type: application/json

{
  "fullName": "Paciente de prueba",
  "age": 45,
  "sex": "F",
  "condition": "Rehabilitación de rodilla",
  "technologyLevel": "medium"
}

###

POST {{PF3311.TeleRehab.Api_HostAddress}}/api/therapies/generate/{{patientId}}

###

GET {{PF3311.TeleRehab.Api_HostAddress}}/api/patients/{{patientId}}

###

GET {{PF3311.TeleRehab.Api_HostAddress}}/api/therapies/patient/{{patientId}}

###

POST {{PF3311.TeleRehab.Api_HostAddress}}/api/motivation/message
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "therapyId": "{{therapyId}}"
}

###

POST {{PF3311.TeleRehab.Api_HostAddress}}/api/speech/synthesize
Content-Type: application/json

{
  "text": "Recuerda realizar el ejercicio lentamente y detenerte si sientes dolor.",
  "sex": "M"
}
